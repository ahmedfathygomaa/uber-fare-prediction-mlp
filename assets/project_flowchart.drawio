        <mxCell id="n25" parent="s11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Weight update&lt;/b&gt;&lt;br&gt;Adam, η = 0.001" vertex="1"><mxGeometry height="62" width="176" x="470" y="166" as="geometry"/></mxCell>
