        <mxCell id="e11yes" edge="1" parent="s11" source="n27" target="n28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#455A64;fontSize=12;fontStyle=1;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeWidth=1.8;fontSize=11;" value="Yes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t11a" parent="s11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;fontSize=11;fontStyle=2;fontColor=#5D4037;" value="Backpropagation = computes the gradient&lt;br&gt;Adam = sets the step size" vertex="1"><mxGeometry height="56" width="230" x="430" y="264" as="geometry"/></mxCell>
        <mxCell id="n29" parent="s11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;dashed=1;" value="&lt;b&gt;B) In this notebook:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;TRAIN_FROM_SCRATCH = False&lt;/font&gt; → saved weights loaded from the checkpoint · &lt;b&gt;no retraining&lt;/b&gt;" vertex="1"><mxGeometry height="40" width="632" x="14" y="330" as="geometry"/></mxCell>
        <mxCell id="t11b" parent="s11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;fontSize=12;" value="MSE · Adam η = 0.001 · batch 64 · at most 100 epochs · EarlyStopping patience 10 · seed 42&lt;br&gt;&lt;b&gt;BP1–BP4 verification (9.1):&lt;/b&gt; manual NumPy = TensorFlow, relative difference ≈ 3·10⁻⁷" vertex="1"><mxGeometry height="44" width="660" y="376" as="geometry"/></mxCell>
        <mxCell id="s12" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#00695C;swimlaneFillColor=#E8F5F3;strokeColor=#00695C;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="12  Validation and Test Evaluation&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 10&lt;/span&gt;" vertex="1"><mxGeometry height="432" width="520" x="730" y="900" as="geometry"/></mxCell>
        <mxCell id="n12a" parent="s12" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00695C;strokeWidth=1.8;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Validation&lt;/b&gt; (2013-06 → 2014-06)&lt;br&gt;MLP: MAE 1.887 · &lt;b&gt;RMSE 3.849&lt;/b&gt; · R² 0.869" vertex="1"><mxGeometry height="66" width="492" x="14" y="52" as="geometry"/></mxCell>
        <mxCell id="n12b" parent="s12" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B71C1C;strokeWidth=1.8;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Test&lt;/b&gt; (2014-06 → 2015-06, after selection)&lt;br&gt;MLP: MAE 1.920 · &lt;b&gt;RMSE 3.321&lt;/b&gt; · R² 0.908" vertex="1"><mxGeometry height="66" width="492" x="14" y="132" as="geometry"/></mxCell>
        <mxCell id="t12" parent="s12" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Comparison – Linear Regression:&lt;/b&gt;&lt;br&gt;validation RMSE 4.693 · test RMSE 4.181 · test R² 0.853&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#00695C&quot;&gt;&lt;b&gt;MLP test RMSE: 4.181 → 3.321 USD (−20.6%)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Note: the test period was examined in an earlier version →&lt;br&gt;not a fully independent test&lt;/i&gt;" vertex="1"><mxGeometry height="160" width="520" y="214" as="geometry"/></mxCell>
        <mxCell id="s13" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#00695C;swimlaneFillColor=#E8F5F3;strokeColor=#00695C;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="13  Error Analysis&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 10.1–10.2&lt;/span&gt;" vertex="1"><mxGeometry height="432" width="480" x="1300" y="900" as="geometry"/></mxCell>
        <mxCell id="t13" parent="s13" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Where does the model still make errors?&lt;/b&gt; (validation)&lt;br&gt;Residual = y − ŷ (+ = under-prediction)&lt;br&gt;&lt;br&gt;&lt;b&gt;• Expensive rides: under-predicted&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;40–60 USD: mean +4.54 · ≥ 60 USD: +12.19&lt;br&gt;&lt;br&gt;&lt;b&gt;• Airport rides: large errors&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;MAE: LGA 4.0 · JFK 4.7 · EWR 10.0 (n = 52)&lt;br&gt;&amp;nbsp;&amp;nbsp;overall MAE: 1.9&lt;br&gt;&lt;br&gt;The MLP clearly reduces the error in these groups&lt;br&gt;compared with Linear Regression, but the problem remains." vertex="1"><mxGeometry height="384" width="480" y="36" as="geometry"/></mxCell>
        <mxCell id="s14" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#B71C1C;swimlaneFillColor=#FDEDED;strokeColor=#B71C1C;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="14  Conclusions and Limitations&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 11&lt;/span&gt;" vertex="1"><mxGeometry height="432" width="490" x="1830" y="900" as="geometry"/></mxCell>
        <mxCell id="t14" parent="s14" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Conclusions&lt;/b&gt;&lt;br&gt;• The MLP reduced test RMSE by 20.6% (4.181 → 3.321)&lt;br&gt;• Feature engineering: distance, direction, time and&lt;br&gt;&amp;nbsp;&amp;nbsp;fare-regime information provided directly&lt;br&gt;• 64 → 32: selected by a predefined rule&lt;br&gt;• BP1–BP4 manual = TensorFlow&lt;br&gt;&lt;br&gt;&lt;b&gt;Limitations&lt;/b&gt;&lt;br&gt;• No traffic, actual route or trip-duration information&lt;br&gt;• Large errors for expensive / airport rides&lt;br&gt;• Test period seen in an earlier version&lt;br&gt;&amp;nbsp;&amp;nbsp;→ not fully independent&lt;br&gt;• Hour = NY local time is an assumption (DST)" vertex="1"><mxGeometry height="384" width="490" y="36" as="geometry"/></mxCell>
