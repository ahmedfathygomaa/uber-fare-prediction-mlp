<mxfile host="65bd71144e">
  <diagram id="uber-one-page" name="Uber Project Workflow">
    <mxGraphModel dx="1752" dy="2348" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1440" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontColor=#1F2D3D;spacingLeft=4;" value="&lt;b&gt;Uber Fare Prediction – End-to-End Project Workflow with an MLP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;&quot;&gt;Data → preparation → baseline → architecture comparison and selection → MLP construction → training → evaluation → conclusions · reading order: 1→5 right, 6→10 left, 11→14 right&lt;/span&gt;" vertex="1"><mxGeometry height="74" width="2000" x="20" y="18" as="geometry"/></mxCell>
        <mxCell id="s1" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#1F4E79;swimlaneFillColor=#EAF2FB;strokeColor=#1F4E79;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="1  Problem Definition&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 1&lt;/span&gt;" vertex="1"><mxGeometry height="330" width="420" x="20" y="110" as="geometry"/></mxCell>
        <mxCell id="t1" parent="s1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Supervised learning – REGRESSION&lt;/b&gt;&lt;br&gt;Target (y): &lt;font face=&quot;Courier New&quot;&gt;fare_amount&lt;/font&gt; (USD, continuous)&lt;br&gt;&lt;br&gt;Question: can the fare be predicted from information&lt;br&gt;known before the ride (location, time, passengers)?&lt;br&gt;&lt;br&gt;Main model: &lt;b&gt;MLP&lt;/b&gt; (Keras, backpropagation + Adam)&lt;br&gt;Baseline: Linear Regression&lt;br&gt;Metrics: RMSE (primary), MAE, R²" vertex="1"><mxGeometry height="294" width="420" y="36" as="geometry"/></mxCell>
        <mxCell id="s2" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#1F4E79;swimlaneFillColor=#EAF2FB;strokeColor=#1F4E79;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="2  Data Loading and EDA&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 3&lt;/span&gt;" vertex="1"><mxGeometry height="330" width="420" x="490" y="110" as="geometry"/></mxCell>
        <mxCell id="t2" parent="s2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;font face=&quot;Courier New&quot;&gt;uber.csv&lt;/font&gt; · &lt;b&gt;200,000 rides&lt;/b&gt; · New York&lt;br&gt;Period: 2009-01 → 2015-06&lt;br&gt;Target: &lt;font face=&quot;Courier New&quot;&gt;fare_amount&lt;/font&gt; · inputs: time, location, passengers&lt;br&gt;&lt;br&gt;&lt;b&gt;Key observations:&lt;/b&gt;&lt;br&gt;• Right-skewed fares → expensive rides kept&lt;br&gt;• Invalid coordinates (0 and outside NYC)&lt;br&gt;• Invalid passenger counts (0 and 208)&lt;br&gt;• 1 row with missing values&lt;br&gt;&lt;br&gt;• YData Profiling: automated data report" vertex="1"><mxGeometry height="294" width="420" y="36" as="geometry"/></mxCell>
        <mxCell id="s3" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#2E7D32;swimlaneFillColor=#EDF7EE;strokeColor=#2E7D32;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="3  Data Cleaning&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 4&lt;/span&gt;" vertex="1"><mxGeometry height="330" width="420" x="960" y="110" as="geometry"/></mxCell>
        <mxCell id="t3" parent="s3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Fixed, justified rules (rows removed):&lt;/b&gt;&lt;br&gt;• Missing values: 1&lt;br&gt;• Coordinates outside NYC box: 4,419&lt;br&gt;• Fare &amp;lt; 2.5 USD (initial charge): 21&lt;br&gt;• Passenger count not 1–6: 686&lt;br&gt;• Distance &amp;lt; 0.1 km (Haversine): 3,107&lt;br&gt;&lt;br&gt;200,000 → &lt;b&gt;191,766 rows&lt;/b&gt; (−8,234)&lt;br&gt;High fares were not removed" vertex="1"><mxGeometry height="294" width="420" y="36" as="geometry"/></mxCell>
        <mxCell id="s4" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#2E7D32;swimlaneFillColor=#EDF7EE;strokeColor=#2E7D32;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="4  Chronological Split&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 5&lt;/span&gt;" vertex="1"><mxGeometry height="330" width="420" x="1430" y="110" as="geometry"/></mxCell>
        <mxCell id="t4" parent="s4" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="Sort by time → split (not random)" vertex="1"><mxGeometry height="30" width="420" y="36" as="geometry"/></mxCell>
        <mxCell id="n4a" parent="s4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#1F4E79;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Training 70%&lt;/b&gt;&lt;br&gt;134,236&lt;br&gt;2009-01 → 2013-06" vertex="1"><mxGeometry height="110" width="150" x="12" y="70" as="geometry"/></mxCell>
        <mxCell id="n4b" parent="s4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B07D00;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;" value="&lt;b&gt;Validation 15%&lt;/b&gt;&lt;br&gt;28,765&lt;br&gt;2013-06 → 2014-06" vertex="1"><mxGeometry height="110" width="120" x="170" y="70" as="geometry"/></mxCell>
        <mxCell id="n4c" parent="s4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#B71C1C;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;" value="&lt;b&gt;Test 15%&lt;/b&gt;&lt;br&gt;28,765&lt;br&gt;2014-06 → 2015-06" vertex="1"><mxGeometry height="110" width="112" x="298" y="70" as="geometry"/></mxCell>
        <mxCell id="t4b" parent="s4" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Validation:&lt;/b&gt; EarlyStopping and model selection&lt;br&gt;&lt;b&gt;Test:&lt;/b&gt; not used for selection; reported at the end&lt;br&gt;&lt;font color=&quot;#B71C1C&quot;&gt;&lt;b&gt;⚠ Test period was examined in an earlier version&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ not fully independent" vertex="1"><mxGeometry height="138" width="420" y="192" as="geometry"/></mxCell>
        <mxCell id="s5" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#2E7D32;swimlaneFillColor=#EDF7EE;strokeColor=#2E7D32;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="5  Feature Engineering&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 6&lt;/span&gt;" vertex="1"><mxGeometry height="330" width="420" x="1900" y="110" as="geometry"/></mxCell>
        <mxCell id="t5" parent="s5" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;From the inputs only, row by row:&lt;/b&gt;&lt;br&gt;• Basic (6): 4 coordinates, &lt;font face=&quot;Courier New&quot;&gt;passenger_count&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;distance_km&lt;/font&gt;&lt;br&gt;• Time (6): &lt;font face=&quot;Courier New&quot;&gt;month&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;is_weekend&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;hour_sin/cos&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;dow_sin/cos&lt;/font&gt; (cyclical)&lt;br&gt;• Geographic (8): Manhattan distances, direction,&lt;br&gt;&amp;nbsp;&amp;nbsp;coordinate differences&lt;br&gt;• Fare regime / trend (2): &lt;font face=&quot;Courier New&quot;&gt;fare_regime&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;elapsed_years&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;= 22 input features&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="294" width="420" y="36" as="geometry"/></mxCell>
        <mxCell id="s6" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#2E7D32;swimlaneFillColor=#EDF7EE;strokeColor=#2E7D32;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="6  Scaling&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 6&lt;/span&gt;" vertex="1"><mxGeometry height="360" width="300" x="2020" y="490" as="geometry"/></mxCell>
        <mxCell id="t6" parent="s6" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;StandardScaler&lt;/b&gt;&lt;br&gt;&lt;br&gt;• fit: TRAINING only&lt;br&gt;• transform: training,&lt;br&gt;&amp;nbsp;&amp;nbsp;validation and test&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;→ no data leakage&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry height="324" width="300" y="36" as="geometry"/></mxCell>
        <mxCell id="s7" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#C55A11;swimlaneFillColor=#FFF4E8;strokeColor=#C55A11;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="7  Baseline Model&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 7&lt;/span&gt;" vertex="1"><mxGeometry height="360" width="300" x="1670" y="490" as="geometry"/></mxCell>
        <mxCell id="t7" parent="s7" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Linear Regression&lt;/b&gt;&lt;br&gt;(single linear neuron)&lt;br&gt;Same 22 features&lt;br&gt;&lt;br&gt;Validation RMSE: 4.693&lt;br&gt;Test RMSE: 4.181&lt;br&gt;&lt;br&gt;The MLP must beat this line" vertex="1"><mxGeometry height="324" width="300" y="36" as="geometry"/></mxCell>
        <mxCell id="s8" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#6A1B9A;swimlaneFillColor=#F6EEFA;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;dashed=1;dashPattern=8 4;" value="8  Architecture Comparison&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 8.1–8.2, App. A&lt;/span&gt;" vertex="1"><mxGeometry height="360" width="490" x="1130" y="490" as="geometry"/></mxCell>
        <mxCell id="n8a" parent="s8" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;dashed=1;" value="&lt;b&gt;📁 Saved experiment results&lt;/b&gt; – not re-run in the notebook" vertex="1"><mxGeometry height="34" width="462" x="14" y="46" as="geometry"/></mxCell>
        <mxCell id="t8" parent="s8" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="5 architectures × 5 seeds × 4 chronological windows = &lt;b&gt;100 training runs&lt;/b&gt;&lt;br&gt;Fixed: 22 features, MSE, Adam, batch 64 · test set not used" vertex="1"><mxGeometry height="52" width="490" y="84" as="geometry"/></mxCell>
        <mxCell id="tbl8" parent="s8" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;overflow=fill;" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EBDDF3;&quot;&gt;&lt;th&gt;Architecture&lt;/th&gt;&lt;th&gt;Parameters&lt;/th&gt;&lt;th&gt;Mean validation RMSE (USD)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;385&lt;/td&gt;&lt;td&gt;3.663&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;32&lt;/td&gt;&lt;td&gt;769&lt;/td&gt;&lt;td&gt;3.656&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;32 → 16&lt;/td&gt;&lt;td&gt;1,281&lt;/td&gt;&lt;td&gt;3.643&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#D7F0DA;font-weight:bold;&quot;&gt;&lt;td&gt;64 → 32&lt;/td&gt;&lt;td&gt;3,585&lt;/td&gt;&lt;td&gt;3.594&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;64 → 32 → 16&lt;/td&gt;&lt;td&gt;4,097&lt;/td&gt;&lt;td&gt;3.596&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="160" width="458" x="16" y="146" as="geometry"/></mxCell>
        <mxCell id="t8b" parent="s8" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;fontSize=11;fontStyle=2;fontColor=#5D4037;" value="Each value is the mean of 20 runs" vertex="1"><mxGeometry height="30" width="490" y="318" as="geometry"/></mxCell>
        <mxCell id="s9" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#6A1B9A;swimlaneFillColor=#F6EEFA;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;dashed=1;dashPattern=8 4;" value="9  Model Selection: 64 → 32&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 8.1&lt;/span&gt;" vertex="1"><mxGeometry height="360" width="440" x="640" y="490" as="geometry"/></mxCell>
        <mxCell id="t9" parent="s9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Predefined rule (applied to the saved results):&lt;/b&gt;&lt;br&gt;① Stable? (no NaN, early stopping ≤ 20%)&lt;br&gt;② Lowest mean RMSE → reference&lt;br&gt;③ Paired diff. ≤ ε (0.025 USD) and no&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;window &amp;gt; 2ε → practically equivalent&lt;br&gt;④ Fewest parameters among equivalent ones" vertex="1"><mxGeometry height="130" width="440" y="38" as="geometry"/></mxCell>
        <mxCell id="t9b" parent="s9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;fontSize=12;" value="• 16, 32, 32-16: difference 2–3 × ε → not equivalent&lt;br&gt;• 64-32-16: mean ≈ equal, but &amp;gt; 2ε in one window&lt;br&gt;&amp;nbsp;&amp;nbsp;and more parameters" vertex="1"><mxGeometry height="80" width="440" y="172" as="geometry"/></mxCell>
        <mxCell id="n9" parent="s9" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D7F0DA;strokeColor=#2E7D32;strokeWidth=1.8;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;Selected: 64 → 32&lt;/b&gt;&lt;br&gt;lowest mean RMSE + satisfies the rule" vertex="1"><mxGeometry height="62" width="408" x="16" y="270" as="geometry"/></mxCell>
        <mxCell id="s10" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#C55A11;swimlaneFillColor=#FFF4E8;strokeColor=#C55A11;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="10  Build the Selected MLP&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 8.3&lt;/span&gt;" vertex="1"><mxGeometry height="360" width="570" x="20" y="490" as="geometry"/></mxCell>
        <mxCell id="n10a" parent="s10" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;22" vertex="1"><mxGeometry height="64" width="100" x="25" y="62" as="geometry"/></mxCell>
        <mxCell id="n10b" parent="s10" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFE0C2;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Dense 64&lt;/b&gt;&lt;br&gt;ReLU" vertex="1"><mxGeometry height="64" width="100" x="165" y="62" as="geometry"/></mxCell>
        <mxCell id="n10c" parent="s10" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFE0C2;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Dense 32&lt;/b&gt;&lt;br&gt;ReLU" vertex="1"><mxGeometry height="64" width="100" x="305" y="62" as="geometry"/></mxCell>
        <mxCell id="n10d" parent="s10" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Output 1&lt;/b&gt;&lt;br&gt;linear" vertex="1"><mxGeometry height="64" width="100" x="445" y="62" as="geometry"/></mxCell>
        <mxCell id="e100" edge="1" parent="s10" source="n10a" target="n10b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#455A64;fontSize=12;fontStyle=1;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeWidth=1.8;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e101" edge="1" parent="s10" source="n10b" target="n10c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#455A64;fontSize=12;fontStyle=1;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeWidth=1.8;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e102" edge="1" parent="s10" source="n10c" target="n10d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#455A64;fontSize=12;fontStyle=1;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeWidth=1.8;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t10" parent="s10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;22 → 64 → 32 → 1&lt;/b&gt; · 3,585 parameters&lt;br&gt;(1,472 + 2,080 + 33; &lt;font face=&quot;Courier New&quot;&gt;model.summary()&lt;/font&gt;)&lt;br&gt;&lt;br&gt;• Hidden layers: ReLU&lt;br&gt;• Output: linear (fare is a continuous value)&lt;br&gt;• Initialization: Glorot-uniform&lt;br&gt;• Keras &lt;font face=&quot;Courier New&quot;&gt;Sequential&lt;/font&gt; – &lt;font face=&quot;Courier New&quot;&gt;build_mlp()&lt;/font&gt;" vertex="1"><mxGeometry height="214" width="570" y="146" as="geometry"/></mxCell>
        <mxCell id="s11" parent="1" style="swimlane;startSize=36;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#C55A11;swimlaneFillColor=#FFF4E8;strokeColor=#C55A11;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=10;collapsible=0;container=1;" value="11  Training: Backpropagation + Adam&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;   📓 9, 9.1&lt;/span&gt;" vertex="1"><mxGeometry height="432" width="660" x="20" y="900" as="geometry"/></mxCell>
        <mxCell id="t11h" parent="s11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=13;fontColor=#1A1A1A;" value="&lt;b&gt;A) Original training&lt;/b&gt; – performed earlier (&lt;font face=&quot;Courier New&quot;&gt;train_mlp()&lt;/font&gt;)" vertex="1"><mxGeometry height="26" width="660" y="38" as="geometry"/></mxCell>
        <mxCell id="n21" parent="s11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="Mini-batch&lt;br&gt;(64 samples)" vertex="1"><mxGeometry height="58" width="120" x="14" y="68" as="geometry"/></mxCell>
        <mxCell id="n22" parent="s11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Forward pass&lt;/b&gt;&lt;br&gt;ŷ = f(W·x + b)" vertex="1"><mxGeometry height="58" width="140" x="166" y="68" as="geometry"/></mxCell>
        <mxCell id="n23" parent="s11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.8;fontSize=12;fontColor=#1A1A1A;" value="&lt;b&gt;Loss&lt;/b&gt;&lt;br&gt;MSE(y, ŷ)" vertex="1"><mxGeometry height="58" width="120" x="338" y="68" as="geometry"/></mxCell>
